rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === COLECCIONES PUBLICAS (lectura web + formularios abiertos) ===
    // Estas necesitan escritura publica para formularios sin login

    match /viaticos/{document} {
      allow read: if true;
      allow write: if true;  // formulario publico solicitud-viaticos.html
    }

    match /descargas/{document} {
      allow read: if true;
      allow write: if true;  // registro publico de descargas
    }

    match /inscripciones_cultura/{document} {
      allow read: if true;
      allow write: if true;  // formularios publicos de inscripcion
    }

    // === COLECCIONES PROTEGIDAS ===
    // Lectura publica para que la web funcione
    // Escritura solo usuarios logueados (dashboard)

    match /socios/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /afiliados/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /secretarias/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /portadas/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /config_site/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /anuncios/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /eventos/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /eventos_cultura/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /actividades/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /fotos/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /albumes/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /documentos_cultura/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /documentos_oficiales/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /balances/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /campos_extra/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /campanas_actualizacion/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Solo usuarios logueados pueden ver/escribir admins
    match /admins/{document} {
      allow read, write: if request.auth != null;
    }

    // Bloquear cualquier otra coleccion no listada
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
