rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura publica para consultas
    match /viaticos/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /socios/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /secretarias/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /descargas/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /afiliados/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /eventos/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /admins/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /config_site/{document} {
      allow read: if true;
      allow write: if true;
    }
    // Bloquear todo lo demas (produccion)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
